# Copy to .env in this repo (gitignored) and chmod 600.
# Resolution: process env → repo .env → ~/.cursor/skills/.env
# Empty values are skipped.

# CFBD_API_KEY
#   Used by: ncaaf.optimize (default week-1 objective = Vegas implied totals)
#   GET https://api.collegefootballdata.com/lines  (Authorization: Bearer)
#   Free key: https://collegefootballdata.com/key
CFBD_API_KEY=

# ODDS_API_KEY  (game-line fallback + NCAAF player-prop overlay)
#   Used by: ncaaf.optimize, ncaaf.props
#   GET .../americanfootball_ncaaf/events and .../events/{id}/odds
#   Key: https://the-odds-api.com/  (~70 credits per slate; cached)
ODDS_API_KEY=

# OURLADS_CONTACT_EMAIL
#   Used by: ncaaf.depth / ncaaf.optimize / nfl.depth / nfl.optimize
#   Identified User-Agent + From header
#   Grants: ncaaf/docs/data/ourlads-authorization.md (NCAA)
#           nfl/docs/data/ourlads-authorization.md (NFL)
#   Default if unset: tucker.maus@ourlads.com (already used in vendor forms)
OURLADS_CONTACT_EMAIL=
