# Copy to .env in this repo (gitignored) and chmod 600.
# Resolution: process env → repo .env → ~/.cursor/skills/.env
# Empty values are skipped.

# CFBD_API_KEY
#   Used by: ncaaf.optimize (default week-1 objective = Vegas implied totals)
#   GET https://api.collegefootballdata.com/lines  (Authorization: Bearer)
#   Free key: https://collegefootballdata.com/key
CFBD_API_KEY=

# ODDS_API_KEY  (NFL game lines + NCAAF game-line fallback + NCAAF player props)
#   Used by: nfl.lines, ncaaf.optimize, ncaaf.props
#   NFL player props do not use this key (see GANGSTASH_API_KEY).
#   GET .../americanfootball_nfl/odds and .../americanfootball_ncaaf/events
#   Key: https://the-odds-api.com/  (NCAAF props ~70 credits per slate; cached)
ODDS_API_KEY=

# GANGSTASH_API_KEY  (NFL player props + default /data datasets)
#   Used by: nfl.props / nfl.optimize. Defaults are gangstash lines, targets,
#   snaps, and depth. Fallbacks: --lines-source=oddsapi --targets-source=lineups
#   --snaps-source=lineups --depth-source=ourlads
#   Props: GET https://vmzgpslqoeuqmdchdekm.supabase.co/functions/v1/props
#   Other datasets: GET .../functions/v1/data?dataset=<name>
#   Header: x-api-key  (never a Supabase service-role key; do not put the key in the URL)
#   Props cache: nfl/data/gangstash-props/
#   Dataset cache: nfl/data/gangstash-data/
#   Do not commit a real key.
GANGSTASH_API_KEY=

# Optional overrides. Defaults match the live dataset= query values.
# GANGSTASH_DATA_PATH=data
# GANGSTASH_TARGETS_DATASET=targets
# GANGSTASH_GAME_LINES_DATASET=game_lines
# GANGSTASH_DEPTH_DATASET=depth_charts
# GANGSTASH_TEAM_STATS_DATASET=team_stats
# GANGSTASH_TEAM_STATS_WEEKLY_DATASET=team_stats_weekly
# GANGSTASH_SNAPS_DATASET=snaps

# GANGSTASH_PROJECTIONS_KEY  (write key for nightly projections)
#   Used by: python3 -m nfl.publish_projections
#   POST https://vmzgpslqoeuqmdchdekm.supabase.co/functions/v1/projections
#   Header: x-api-key  (never a Supabase service-role key; do not put the key in the URL)
#   Reads (game lines, depth, targets, snaps, props) still use GANGSTASH_API_KEY.
#   Do not commit a real key.
GANGSTASH_PROJECTIONS_KEY=

# GANGSTASH_LIVE_SMOKE=1
#   With GANGSTASH_API_KEY, runs the optional live /data contract test.
#   Leave unset for normal unit tests (no network).

# OURLADS_CONTACT_EMAIL
#   Used by: ncaaf.depth / ncaaf.optimize / nfl.depth / nfl.optimize
#   Identified User-Agent + From header
#   Grants: ncaaf/docs/data/ourlads-authorization.md (NCAA)
#           nfl/docs/data/ourlads-authorization.md (NFL)
#   Default if unset: tucker.maus@ourlads.com (already used in vendor forms)
OURLADS_CONTACT_EMAIL=
